# vim: ft=sshconfig
Include ~/.orbstack/ssh/config

Host *
  addKeysToAgent yes
  compression yes
  controlMaster no
  controlPath ~/.ssh/master-%r@%n:%p
  controlPersist no
  hashKnownHosts yes
  serverAliveCountMax 3
  serverAliveInterval 0
  useKeychain yes
  userKnownHostsFile ~/.ssh/known_hosts

Host bgp.tools
  hostname bgp.tools
  user lg

Host github.com
  hostname github.com
  user git

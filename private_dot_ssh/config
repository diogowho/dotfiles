# vim: ft=sshconfig
Host *
  addKeysToAgent yes
  compression yes
  controlMaster no
  controlPath ~/.ssh/master-%r@%n:%p
  controlPersist no
  hashKnownHosts yes
  serverAliveCountMax 3
  serverAliveInterval 0
  useKeychain yes
  userKnownHostsFile ~/.ssh/known_hosts


# vim: ft=zsh
PROMPT='%F{blue}%~ %f%(?.%F{magenta}.%F{red})~> %f'

HISTFILE=~/.zsh_history
HISTSIZE=1000000000
SAVEHIST=1000000000
HISTFILESIZE=1000000000
HISTTIMEFORMAT='[%F %T] '
setopt share_history
setopt extended_history
setopt hist_ignore_dups
setopt hist_ignore_space
autoload -U history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end

source "$HOME/.zsh_aliases"

export DO_NOT_TRACK=1
export EDITOR='nvim'
export FZF_DEFAULT_OPTS="--height=40% --layout=reverse --border --preview-window=right:60% --preview 'bat --color=always --style=numbers --line-range=:500 {}'"
export VISUAL='nvim'
export HOMEBREW_NO_REQUIRE_TAP_TRUST=1
export HOMEBREW_NO_ENV_HINTS=1
export XDG_CONFIG_HOME='/Users/diogo/.config'
export SOPS_AGE_KEY_FILE='/Volumes/raven/age.txt'
export PATH="$HOME/scripts:$PATH"

